extends RefCounted
## К11: фывфыв — чёрный котёнок с золотыми зубами, наставник кражи.
##
## Канон (решения автора 06.09.2026): стоит перед фермой бабушки; сначала даёт
## гайд, потом участвует в краже; у него всегда получается; игрока не обманывает;
## при фейке бабушки советует «оставайся тихо».
##
## Реплики фывфыва в плане помечены как **открытые** — за автором. Поэтому здесь
## нет придуманной речи: есть только его утверждённый совет и технические
## подсказки-инструкции, которые показываются как подсказки интерфейса.

## Утверждённая фраза-совет при фейке бабушки (канон).
const FAKE_ADVICE := "оставайся тихо"

## Гайд перед кражей: это инструкции, а не реплики персонажа.
const GUIDE := [
	"Перебегай от куста к кусту, пока бабушка смотрит в другую сторону",
	"В зоне взгляда стоять нельзя — заметит",
	"Когда она кричит «Я вас вижу, выходите!» — это может быть и правда, и проверка",
	"Совет при крике: оставайся тихо",
	"Корзина наберётся, когда соберёшь все 42 клубнички",
]

var guide_read := false       # игрок уже получил гайд
var helped := false           # участвовал в краже (совет при фейке)

func reset() -> void:
	guide_read = false
	helped = false

func guide_lines() -> Array:
	guide_read = true
	return GUIDE.duplicate()

func advice_for_fake() -> String:
	# При фейке фывфыв советует то же, что и при правде: он не обманывает.
	helped = true
	return FAKE_ADVICE
