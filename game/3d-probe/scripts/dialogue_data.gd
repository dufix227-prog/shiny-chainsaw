static func by_id(id: String) -> Dictionary:
	if id == TEST_NPC.id:
		return TEST_NPC
	if id == CHURCH_CONFESSION.id:
		return CHURCH_CONFESSION
	if id == CHURCH_BEGGAR.id:
		return CHURCH_BEGGAR
	if id == STINT.id:
		return STINT
	if id == BRATISHKIN.id:
		return BRATISHKIN
	return {}
