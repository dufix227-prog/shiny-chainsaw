config_version=5

[application]
config/name="Пролог · 3D-проба"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameSettings="*res://scenes/game_settings.gd"
Controls="*res://scenes/controls.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="camera_only"

[physics]
; Keep normal simulation speed in the software-rendered preview below 8 FPS.
common/max_physics_steps_per_frame=64

[rendering]
; Forward+ выбран по решению автора 11.09.2026 («движку плевать на веб,
; улучшай»): даёт glow/SSAO/volumetric fog, недоступные на GL Compatibility.
; Steam Deck (AMD, аппаратный Vulkan) и Windows/Linux-десктоп тянут Forward+
; штатно; единственная цена — Web-экспорт (WebGL2 не поддерживает Vulkan) и
; dev-Preview в браузере песочницы Hoplite, которые этим не покрываются.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.59, 0.75, 0.79, 1)

[audio]
driver/enable_input=false
